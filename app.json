{
  "expo": {
    "name": "L'AMOUR GOLD",
    "slug": "lamour-gold",
    "scheme": "lamourgold",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080808",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lamourgold.app"
    },
    "android": {
      "package": "com.lamourgold.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "30bad0b1-af1b-4e3c-a3ec-8161bdf68d5f"
      }
    }
  }
}
